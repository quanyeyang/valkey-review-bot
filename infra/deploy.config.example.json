  "skillsRepo": {
    "repo": "your-org/valkey-review-bot",
    "baseBranch": "main"
  },
  "dailyReviewBudget": 40,
  "maxAutomaticReviewsPerPr": 3,
  "pushReviewDelaySeconds": 300
