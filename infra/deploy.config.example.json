      "readyLabel": "ready-for-human-review"
    },
    {
      "id": "valkey-glide-review",
      "reviewer": "valkey-glide-review",
      "repo": "your-org/valkey-glide",
      "threadReplyReview": true,
      "readyLabel": "ready-for-human-review"
    }
  ],
  "curatorOnlyRoutes": [],
